{
  "name": "starline",
  "private": true,
  "version": "0.1.0",
  "description": "Star Line — Bus Transportation Management Platform",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm build:packages && pnpm --filter @starline/api build && pnpm --filter @starline/web build",
    "dev": "pnpm build:packages && concurrently -k -n api,web -c blue,green \"pnpm --filter @starline/api start:dev\" \"pnpm --filter @starline/web dev\"",
    "dev:api": "pnpm build:packages && pnpm --filter @starline/api start:dev",
    "dev:web": "pnpm --filter @starline/web dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @starline/api db:migrate",
    "db:seed": "pnpm --filter @starline/api db:seed",
    "db:reset": "pnpm --filter @starline/api db:reset",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
