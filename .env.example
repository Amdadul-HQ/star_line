# Root example env. Real values live in:
#   apps/api/.env        (backend + database)
#   apps/web/.env.local  (frontend)

# --- apps/api/.env ---
DATABASE_URL=postgresql://starline:starline_dev_pw@localhost:5433/starline?schema=public
PORT=4010
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
OTP_PROVIDER=sandbox
OTP_SANDBOX_CODE=123456
GPS_STALE_AFTER_SECONDS=60
GPS_OFFLINE_AFTER_SECONDS=300

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4777
NEXT_PUBLIC_WS_URL=http://localhost:4777
